{
  "name": "dsh-code-block-preview",
  "version": "0.2.1",
  "private": false,
  "type": "module",
  "description": "Preview HTML, SVG, and Markdown code blocks in a sandboxed frame inside the DSH Web chat.",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/NOTICE.md",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "vendor/marked.umd.js",
    "vendor/marked.LICENSE.md",
    "vendor/marked.package.json"
  ],
  "scripts": {
    "build": "node tools/build-client.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "code-block",
    "preview",
    "markdown"
  ]
}
